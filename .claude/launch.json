{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "finance-app (Vite dev)",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "npx vite --port ${PORT:-5175}"],
      "autoPort": true,
      "cwd": "finance-app"
    },
    {
      "name": "finance-app (Vite dev alt)",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "npx vite --port 5177 --strictPort"],
      "cwd": "finance-app"
    },
    {
      "name": "finance-local (no auth)",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "VITE_DATA_PROVIDER=local npx vite --port ${PORT:-5176}"],
      "autoPort": true,
      "cwd": "finance-app"
    },
    {
      "name": "finance-app (preview prod)",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "npx vite preview --port ${PORT:-4173}"],
      "autoPort": true,
      "cwd": "finance-app"
    },
    {
      "name": "finance-app (backend server)",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "node index.js"],
      "cwd": "finance-app/server",
      "port": 8787
    },
    {
      "name": "finance-app (mcp http)",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "MCP_TRANSPORT=http MCP_PORT=3010 npx tsx src/index.ts"],
      "cwd": "finance-app/mcp",
      "port": 3010
    }
  ]
}
