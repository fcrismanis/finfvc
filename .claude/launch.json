{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "finance-app (Vite dev)",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "npx vite --port ${PORT:-5175}"],
      "autoPort": true,
      "cwd": "finance-app"
