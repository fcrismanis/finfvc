# Supabase — use Service Role Key (bypassa RLS, acesso total)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ID da família no FINFVC (UUID do auth.users ou families table)
FAMILY_ID=

# Fallback: path para JSON exportado do localStorage (quando sem Supabase)
# LOCAL_DATA_PATH=./finance_export.json

# ── Pluggy / Open Finance (somente leitura) ─────────────────────────────────
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Items conhecidos (csv) e/ou o backup de conexões gerado pelo FINFVC
PLUGGY_ITEM_IDS=
# PLUGGY_CONNECTIONS_FILE=../server/.data/pluggy-connections.json

# ── Modo HTTP remoto ─────────────────────────────────────────────────────────
# Obrigatório ao expor fora do localhost. Gere com: openssl rand -hex 32
MCP_AUTH_TOKEN=
